# ─── SafeSense AI — Environment Variables ─────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real credentials to source control.

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# VITE_ prefix makes variables available to the browser (public).
# Do NOT put secrets here.

# URL of the FastAPI backend (leave blank to run in demo-only mode)
VITE_API_URL=http://localhost:8000

VITE_APP_NAME=SafeSense AI
VITE_APP_ENV=development

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# To enable Google Sign-In:
# 1. Create a project at https://console.cloud.google.com
# 2. Enable the Google Identity Services API
# 3. Create OAuth 2.0 credentials (Web application type)
# 4. Add your app's origin and redirect URI (e.g. http://localhost:5173/auth/google/callback)
# 5. Paste the Client ID below
# VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# ─── Backend (Python FastAPI) ─────────────────────────────────────────────────
# These are read server-side only.

# PostgreSQL connection string
DATABASE_URL=postgresql://safesense:safesense@localhost:5432/safesense_db

# JWT secret — use a long random string in production
SECRET_KEY=change-me-in-production-use-a-long-random-string-here

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application environment: development | staging | production
APP_ENV=development

# ─── Optional AI/ML Integrations ──────────────────────────────────────────────
# Not required for baseline operation — the built-in NLP engine runs without these.

# OpenAI API key (optional — enables enhanced NLP responses via GPT)
# OPENAI_API_KEY=sk-...

# Cloud Speech-to-Text API key (optional — browser Web Speech API is used by default)
# SPEECH_API_KEY=...

# ─── Supabase (optional) ──────────────────────────────────────────────────────
# If deploying on Supabase instead of self-hosted PostgreSQL:
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Note: Service role key must NEVER be in VITE_ variables — use server-side only.

# ─── Production Security ──────────────────────────────────────────────────────
# BCRYPT_ROUNDS=12  (default)
# RATE_LIMIT_PER_MINUTE=60  (default)

# ─── Cloud Deployment Notes ───────────────────────────────────────────────────
# AWS: Set these via AWS Secrets Manager or Parameter Store, not in .env files.
# GCP: Use Secret Manager for production secrets.
# Docker: Pass via --env-file or environment section in docker-compose.yml.
# Never commit real secrets to git.
