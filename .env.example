# SAFE-SENSE AI — Environment Configuration
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real credentials to source control.
#
# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
#
# ─── AI Service ───────────────────────────────────────────────────────────────
# If not set, the prototype mock assessment engine will be used.
# Set this to your Python/FastAPI AI service URL when ready.
# VITE_AI_SERVICE_URL=https://your-ai-service.example.com
#
# ─── App Config ───────────────────────────────────────────────────────────────
VITE_APP_NAME=SAFE-SENSE AI
VITE_APP_ENV=development
#
# ─── Notes ────────────────────────────────────────────────────────────────────
# - VITE_ prefix makes variables available in the browser (public)
# - Never put secret keys (service_role, private keys) in VITE_ variables
# - Use Supabase Edge Functions or a backend service for server-side operations
# - In production, use your hosting provider's environment variable management
